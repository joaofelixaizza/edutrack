# Configurações de Email para Recuperação de Senha
# Substitua a senha abaixo pela Senha de App gerada no Google:
# https://myaccount.google.com/apppasswords
SMTP_EMAIL=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-de-app-aqui

# Chave API do Gemini (IA Tutora)
# Obtenha gratuitamente em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua-chave-gemini-aqui
